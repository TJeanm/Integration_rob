#!/usr/bin/env python3
"""Animate the Room 315 TIAGo delivery from the entrance door and expose hand-off services."""

import math
import os
import threading
import time

import rclpy
from rclpy.executors import MultiThreadedExecutor
from rclpy.node import Node
from ros_gz_interfaces.msg import Entity
from ros_gz_interfaces.srv import SetEntityPose
from std_srvs.srv import Trigger

# Waypoints de la trajectoire depuis la porte d'entrée de la salle 315 :
# 1. Départ à la porte d'entrée : X = -7.20, Y = -0.85, cap Ouest (yaw = 180° = pi)
# 2. Virage au coin de l'allée : X = -14.1122, Y = -0.85 (rotation 90° vers le Sud, yaw = -90°)
# 3. Quai de déchargement HC10 : X = -14.1122, Y = -2.45
# Le plateau est monté à 55 cm dans le sens d'avancement du TIAGo.
# Au quai, avec yaw = -90° (vers -Y), le plateau est à Y = -2.45 - 0.55 = -3.00 (point de prise HC10).
DOOR_X = -7.20
CORNER_X = -14.1122
AISLE_Y = -0.85
DOCK_Y = -2.45
TRAY_OFFSET = 0.55


def smoothstep(r: float) -> float:
    r = max(0.0, min(1.0, r))
    return r * r * (3.0 - 2.0 * r)


class TiagoDelivery(Node):
    def __init__(self):
        super().__init__('hc10_tiago_delivery')
        self.pose_client = self.create_client(
            SetEntityPose, '/world/room_315_only/set_pose')
        self.create_service(Trigger, '/hc10/tiago_ready', self.ready)
        self.create_service(Trigger, '/hc10/tiago_depart', self.depart)
        self.arrived = False
        self.moving = False
        self.lock = threading.Lock()

        # Initialiser la pose à la porte dès que Gazebo est prêt
        threading.Thread(target=self.init_door_pose, daemon=True).start()

        # Démarrage automatique optionnel via variable d'environnement (ex: TIAGO_AUTO_START_DELAY=15)
        # Par défaut, attend que pick_place / demo.sh appelle /hc10/tiago_ready afin de laisser
        # le temps à Gazebo et RViz de s'afficher complètement.
        auto_delay = float(os.environ.get('TIAGO_AUTO_START_DELAY', '0'))
        if auto_delay > 0:
            self.timer = self.create_timer(auto_delay, self.start_arrival)
            self.get_logger().info(
                f"TIAGo à la porte d'entrée, démarrage automatique dans {auto_delay}s")
        else:
            self.timer = None
            self.get_logger().info(
                "TIAGo positionné à la porte d'entrée (départ synchronisé avec demo.sh / /hc10/tiago_ready)")

    def init_door_pose(self):
        if self.pose_client.wait_for_service(timeout_sec=15.0):
            time.sleep(0.5)
            self.set_actor_poses(DOOR_X, AISLE_Y, math.pi, with_cube=True)

    def start_arrival(self):
        if self.timer is not None:
            self.timer.cancel()
        self.launch_move(True)

    def launch_move(self, arriving: bool):
        with self.lock:
            if self.moving:
                return False
            self.moving = True
        threading.Thread(
            target=self.move_routine, args=(arriving,), daemon=True).start()
        return True

    def set_actor_poses(self, x: float, y: float, theta: float, with_cube: bool):
        # TIAGo base
        qz = math.sin(theta / 2.0)
        qw = math.cos(theta / 2.0)

        req_robot = SetEntityPose.Request()
        req_robot.entity.name = 'tiago_delivery'
        req_robot.entity.type = Entity.MODEL
        req_robot.pose.position.x = x
        req_robot.pose.position.y = y
        req_robot.pose.position.z = 0.02
        req_robot.pose.orientation.z = qz
        req_robot.pose.orientation.w = qw
        self.pose_client.call_async(req_robot)

        # Plateau payload : décalé de TRAY_OFFSET selon le cap theta
        x_tray = x + TRAY_OFFSET * math.cos(theta)
        y_tray = y + TRAY_OFFSET * math.sin(theta)

        req_payload = SetEntityPose.Request()
        req_payload.entity.name = 'tiago_delivery_payload'
        req_payload.entity.type = Entity.MODEL
        req_payload.pose.position.x = x_tray
        req_payload.pose.position.y = y_tray
        req_payload.pose.position.z = 0.0
        req_payload.pose.orientation.z = qz
        req_payload.pose.orientation.w = qw
        self.pose_client.call_async(req_payload)

        # Cube rouge sur le plateau (si le TIAGo amène la pièce)
        if with_cube:
            req_cube = SetEntityPose.Request()
            req_cube.entity.name = 'red_cube'
            req_cube.entity.type = Entity.MODEL
            req_cube.pose.position.x = x_tray
            req_cube.pose.position.y = y_tray
            req_cube.pose.position.z = 0.875
            req_cube.pose.orientation.z = 0.0
            req_cube.pose.orientation.w = 1.0
            self.pose_client.call_async(req_cube)

    def move_routine(self, arriving: bool):
        try:
            if not self.pose_client.wait_for_service(timeout_sec=20.0):
                self.get_logger().error('Service Gazebo set_pose indisponible')
                return

            dt = 0.08

            if arriving:
                # Pause initiale pour que l'utilisateur visualise bien le TIAGo à la porte
                self.get_logger().info(
                    "TIAGo à la porte d'entrée de la salle 315. Départ vers le quai HC10 dans 2s...")
                time.sleep(2.0)

                # Étape 1 : Allée depuis la porte (X: DOOR_X -> CORNER_X, cap Ouest = pi)
                steps_aisle = 65
                for i in range(steps_aisle + 1):
                    r = smoothstep(i / steps_aisle)
                    x = DOOR_X + (CORNER_X - DOOR_X) * r
                    self.set_actor_poses(x, AISLE_Y, math.pi, with_cube=True)
                    time.sleep(dt)

                # Étape 2 : Virage fluide de 90° vers le Sud (theta: pi -> 3*pi/2 = -pi/2)
                steps_turn = 25
                for i in range(steps_turn + 1):
                    r = smoothstep(i / steps_turn)
                    theta = math.pi + r * (math.pi / 2.0)
                    self.set_actor_poses(CORNER_X, AISLE_Y, theta, with_cube=True)
                    time.sleep(dt)

                # Étape 3 : Entrée dans la cellule jusqu'au quai (Y: AISLE_Y -> DOCK_Y, cap Sud = -pi/2)
                steps_dock = 35
                for i in range(steps_dock + 1):
                    r = smoothstep(i / steps_dock)
                    y = AISLE_Y + (DOCK_Y - AISLE_Y) * r
                    self.set_actor_poses(CORNER_X, y, -math.pi / 2.0, with_cube=True)
                    time.sleep(dt)

                self.arrived = True
                self.get_logger().info("TIAGo à quai depuis la porte d'entrée, pièce disponible")
            else:
                time.sleep(1.0)
                # Étape 1 : Sortie de la cellule (Y: DOCK_Y -> AISLE_Y)
                steps_exit = 35
                for i in range(steps_exit + 1):
                    r = smoothstep(i / steps_exit)
                    y = DOCK_Y + (AISLE_Y - DOCK_Y) * r
                    self.set_actor_poses(CORNER_X, y, -math.pi / 2.0, with_cube=False)
                    time.sleep(dt)

                # Étape 2 : Virage vers l'Est (theta: -pi/2 -> 0)
                steps_turn = 25
                for i in range(steps_turn + 1):
                    r = smoothstep(i / steps_turn)
                    theta = -math.pi / 2.0 + r * (math.pi / 2.0)
                    self.set_actor_poses(CORNER_X, AISLE_Y, theta, with_cube=False)
                    time.sleep(dt)

                # Étape 3 : Retour vers la porte (X: CORNER_X -> DOOR_X, cap Est = 0)
                steps_aisle = 65
                for i in range(steps_aisle + 1):
                    r = smoothstep(i / steps_aisle)
                    x = CORNER_X + (DOOR_X - CORNER_X) * r
                    self.set_actor_poses(x, AISLE_Y, 0.0, with_cube=False)
                    time.sleep(dt)

                self.arrived = False
                self.get_logger().info("TIAGo retourné à la porte d'entrée")
        finally:
            with self.lock:
                self.moving = False

    def ready(self, _request, response):
        if not self.arrived and not self.moving:
            self.launch_move(True)
        response.success = self.arrived and not self.moving
        response.message = 'TIAGo à quai' if response.success else 'TIAGo en approche'
        return response

    def depart(self, _request, response):
        if not self.arrived or self.moving:
            response.success = False
            response.message = 'TIAGo indisponible ou déjà en mouvement'
            return response
        response.success = self.launch_move(False)
        response.message = ('Départ TIAGo lancé' if response.success
                            else 'TIAGo déjà en mouvement')
        return response


def main():
    rclpy.init()
    node = TiagoDelivery()
    executor = MultiThreadedExecutor(num_threads=2)
    executor.add_node(node)
    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        executor.shutdown()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
