#!/usr/bin/env python3
"""Publish the Room 315 RGB-D cloud used by the HC10 collision OctoMap."""

from geometry_msgs.msg import PoseStamped
import numpy as np
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import HistoryPolicy, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import PointCloud2
from sensor_msgs_py import point_cloud2

INPUT_TOPIC = '/room_315/perception/right_rail_rgbd/points'
COLLISION_TOPIC = '/hc10/collision_cloud'
CAMERA_TOPIC = '/hc10/right_camera_cloud'
OUTPUT_FRAME = 'room315_right_rail_rgbd_optical_frame'
ROTATION = np.array([[0, 1, 0], [0, 0, -1], [-1, 0, 0]], dtype=np.float32)
ORIGIN = np.array([-1.7000, -0.2622, 3.3300], dtype=np.float32)
INPUT_PERIOD_NS = 200_000_000
OUTPUT_PERIOD_NS = 1_000_000_000
WATCHDOG_PERIOD_S = 5.0


class Perception(Node):
    def __init__(self):
        super().__init__('hc10_room315_perception')
        self.last_input_ns = 0
        self.last_output_ns = 0
        self.reported_input = False
        self.last_warning_ns = 0
        self.silent_periods = 0
        self.collision_pub = self.create_publisher(PointCloud2, COLLISION_TOPIC, 1)
        self.camera_pub = self.create_publisher(PointCloud2, CAMERA_TOPIC, 1)
        self.cube_pub = self.create_publisher(PoseStamped, '/hc10/detected_cube_pose', 1)
        self.subscription = self.create_subscription(
            PointCloud2,
            INPUT_TOPIC,
            self.cloud,
            QoSProfile(
                history=HistoryPolicy.KEEP_LAST,
                depth=1,
                reliability=ReliabilityPolicy.RELIABLE,
            ),
        )
        self.create_timer(WATCHDOG_PERIOD_S, self.watchdog)
        self.get_logger().info(
            f'En attente du nuage caméra sur {INPUT_TOPIC}; '
            f'publication filtrée sur {COLLISION_TOPIC}')

    def warn_throttled(self, message):
        now = self.get_clock().now().nanoseconds
        if now - self.last_warning_ns < OUTPUT_PERIOD_NS:
            return
        self.last_warning_ns = now
        self.get_logger().warning(message)

    def watchdog(self):
        """Say why nothing is published instead of staying silent forever."""
        if self.reported_input:
            return
        self.silent_periods += 1
        waited = int(self.silent_periods * WATCHDOG_PERIOD_S)
        self.get_logger().warning(
            f'Aucun message reçu sur {INPUT_TOPIC} depuis {waited}s. '
            'Vérifier que gazebo.sh tourne et que le pont RGB-D publie: '
            f'ros2 topic hz {INPUT_TOPIC}')

    @staticmethod
    def read_cloud(msg):
        """Return finite XYZ and optional RGB points of a cloud."""
        fields = [f.name for f in msg.fields]
        has_rgb = 'rgb' in fields
        names = ['x', 'y', 'z', 'rgb'] if has_rgb else ['x', 'y', 'z']
        cloud = point_cloud2.read_points_numpy(msg, field_names=names)
        cloud = np.asarray(cloud).reshape(-1, len(names))[::4]
        xyz = cloud[:, :3].astype(np.float32)
        valid = np.isfinite(xyz).all(axis=1)
        xyz = xyz[valid]
        colors = None
        if has_rgb:
            colors = cloud[:, 3][valid].astype(np.float32).view(np.uint32)
        return xyz, colors

    def cloud(self, msg):
        now = self.get_clock().now().nanoseconds
        if now - self.last_input_ns < INPUT_PERIOD_NS:
            return
        self.last_input_ns = now
        try:
            xyz, colors = self.read_cloud(msg)
        except Exception as error:  # noqa: BLE001 - le nœud doit rester vivant
            self.warn_throttled(f'Nuage caméra illisible ({type(error).__name__}: {error})')
            return
        if not self.reported_input:
            self.get_logger().info(
                f'Nuage caméra reçu: {len(xyz)} points valides, frame={msg.header.frame_id}')
            self.reported_input = True
        if not len(xyz):
            self.warn_throttled(
                f'Nuage caméra reçu ({msg.width}x{msg.height}) mais aucun point fini. '
                'Le capteur RGB-D ne rend rien: vérifier le rendu 3D du serveur '
                'Gazebo et la portée de la caméra.')
            return
        points = xyz @ ROTATION.T + ORIGIN
        keep = (
            (points[:, 0] > -4.0) & (points[:, 0] < 4.0)
            & (points[:, 1] > -6.5) & (points[:, 1] < 3.0)
            # The HC10 support tabletop is around z=0 in base_link. Keep a
            # small band below it so the OctoMap protects the robot table.
            & (points[:, 2] > -0.08) & (points[:, 2] < 2.8)
        )
        if not np.any(keep):
            self.warn_throttled(
                f'Nuage reçu mais aucun des {len(xyz)} points ne passe le filtre spatial. '
                'La caméra ne voit probablement que le sol: vérifier que gazebo.sh a bien '
                'créé yaskawa_hc10_1, tiago_delivery et la table dans le monde.')
            return

        # Identification du cube rouge sur le plateau TIAGo à quai
        cube_roi = (
            (points[:, 0] > -0.20) & (points[:, 0] < 0.20)
            & (points[:, 1] > -1.25) & (points[:, 1] < -0.85)
            & (points[:, 2] > 0.22) & (points[:, 2] < 0.38)
        )
        if colors is not None:
            red = (colors >> 16) & 255
            green = (colors >> 8) & 255
            blue = colors & 255
            cube_mask = cube_roi & (red > 120) & (red > green * 1.2) & (red > blue * 1.2)
        else:
            cube_mask = cube_roi

        if np.count_nonzero(cube_mask) >= 3:
            center = np.median(points[cube_mask], axis=0)
            pose_msg = PoseStamped()
            pose_msg.header.stamp = msg.header.stamp
            pose_msg.header.frame_id = 'base_link'
            pose_msg.pose.position.x = float(center[0])
            pose_msg.pose.position.y = float(center[1])
            pose_msg.pose.position.z = float(center[2])
            pose_msg.pose.orientation.w = 1.0
            self.cube_pub.publish(pose_msg)

        if now - self.last_output_ns < OUTPUT_PERIOD_NS:
            return
        self.last_output_ns = now
        header = msg.header
        header.frame_id = OUTPUT_FRAME

        # Affichage RViz complet (avec pièce)
        camera_output = point_cloud2.create_cloud_xyz32(header, xyz[keep].tolist())
        self.camera_pub.publish(camera_output)

        # La pièce doit rester saisissable : les contacts physiques sont gérés par
        # Gazebo, tandis que l'OctoMap protège l'environnement fixe autour de la pince.
        keep_collision = keep & (~cube_mask)
        collision_output = point_cloud2.create_cloud_xyz32(header, xyz[keep_collision].tolist())
        self.collision_pub.publish(collision_output)
        self.get_logger().info(
            f'Nuage de collision publié: {np.count_nonzero(keep_collision)} points '
            f'({np.count_nonzero(cube_mask)} points cube filtrés pour la prise)')


def main():
    rclpy.init()
    node = Perception()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
